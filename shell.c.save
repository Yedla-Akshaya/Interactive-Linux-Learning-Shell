
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    char input[100];
    char history[100][100];
    int history_count = 0;
    while (1) {
        printf("MyShell> ");
        fflush(stdout);

        fgets(input, sizeof(input), stdin);
        input[strcspn(input, "\n")] = '\0';
 
       if (strlen(input) > 0 && history_count < 100) {
    strcpy(history[history_count], input);
    history_count++;
}
        if (strcmp(input, "exit") == 0) {
            break;
        }

        // Split input into command and arguments
        char *args[20];
        int i = 0;

        char *token = strtok(input, " ");

        while (token != NULL && i < 19) {
            args[i] = token;
            i++;
            token = strtok(NULL, " ");
        }

        args[i] = NULL;

        if (args[0] == NULL) {
            continue;
        }

        // Built-in cd command
        if (strcmp(args[0], "cd") == 0) {

            if (args[1] == NULL) {
                printf("Usage: cd <directory>\n");
            }
            else if (chdir(args[1]) != 0) {
                perror("cd");
            }

            continue;
        }

// Built-in hello command
if (strcmp(args[0], "hello") == 0) {
    printf("Hello! Welcome to MyShell.\n");
    continue;
}
// Built-in info command
if (strcmp(args[0], "info") == 0) {
    printf("MyShell - A simple Linux shell written in C\n");
    printf("Process ID: %d\n", getpid());
    continue;
}
    // Built-in help command
    if (strcmp(args[0], "help") == 0) {
        printf("Available commands:\n");
        printf("cd   - Change directory\n");
        printf("pwd  - Show current directory\n");
        printf("help - Show available commands\n");
        printf("exit - Exit MyShell\n");

        continue;
    }

// Built-in history command
if (strcmp(args[0], "history") == 0) {
    for (int j = 0; j < history_count; j++) {
        printf("%d  %s\n", j + 1, history[j]);
    }

    continue;
}

        // Run external command

// Run external command

// Check whether the user typed a pipe
char *pipe_symbol = strchr(input, '|');

if (pipe_symbol != NULL) {

    // Find where "|" is inside args
    int pipe_index = -1;

    for (int j = 0; args[j] != NULL; j++) {
        if (strcmp(args[j], "|") == 0) {
            pipe_index = j;
            break;
        }
    }

    // Split the command into two parts
    args[pipe_index] = NULL;

    char **left_command = args;
    char **right_command = &args[pipe_index + 1];

    // Create the pipe
    int pipefd[2];

    if (pipe(pipefd) == -1) {
        perror("pipe failed");
        continue;
    }

    // Create first child
    pid_t pid1 = fork();

    if (pid1 == 0) {

        // Send stdout into the pipe
        dup2(pipefd[1], STDOUT_FILENO);

        close(pipefd[0]);
        close(pipefd[1]);

        execvp(left_command[0], left_command);

        perror("Command failed");
        exit(1);
    }

    // Create second child
    pid_t pid2 = fork();

    if (pid2 == 0) {

        // Take stdin from the pipe
        dup2(pipefd[0], STDIN_FILENO);

        close(pipefd[0]);
        close(pipefd[1]);

        execvp(right_command[0], right_command);

        perror("Command failed");
        exit(1);
    }

    // Parent doesn't need the pipe anymore
    close(pipefd[0]);
    close(pipefd[1]);

    // Wait for both children
    waitpid(pid1, NULL, 0);
    waitpid(pid2, NULL, 0);

} else {

    // Normal command without pipe
    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");

    } else if (pid == 0) {

        execvp(args[0], args);

        perror("Command failed");
        exit(1);

    } else {

        wait(NULL);
    }
}
